# Copy to .env (never commit .env). No real secrets belong in this file.
NODE_ENV=production
PORT=3000
# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
# Folder on a PERSISTENT disk where school.db / content.db live (leave empty locally)
DATA_DIR=
# Optional: create/repair the admin account automatically on server start
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Principal / Admin
# 1 = admin must choose a new password at first login (recommended), 0 = skip
ADMIN_FORCE_CHANGE=1
# 1 = also overwrite the password of an EXISTING admin with ADMIN_PASSWORD (use once, then remove)
ADMIN_RESET_PASSWORD=0
# School contact (shown on the site where wired)
WHATSAPP_NUMBER=923555241730
